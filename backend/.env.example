# MongoDB
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/lifeops
MONGODB_DB_NAME=lifeops

# Elasticsearch
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_API_KEY=

# Google Cloud
GOOGLE_CLOUD_PROJECT=lifeops-prod
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
BIGQUERY_DATASET=lifeops

# Gemini / Google AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Arize Phoenix
PHOENIX_API_KEY=
PHOENIX_HOST=localhost
PHOENIX_PORT=6006

# JWT
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Fivetran
FIVETRAN_API_KEY=
FIVETRAN_API_SECRET=

# App
APP_SECRET_KEY=
ENVIRONMENT=development
LOG_LEVEL=INFO
